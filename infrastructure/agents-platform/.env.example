# Copy to .env on the VPS, fill in with strong random values, never commit.
# Generate with: openssl rand -base64 32

# Postgres admin (full DDL, migrations, backups)
PG_ADMIN_PASSWORD=

# Postgres app user (DML only — used by prompt-builder, dashboard, auth-service)
PG_APP_PASSWORD=

# JWT signing key for the auth service (HS256)
JWT_SECRET=

# Resend API key for OTP email delivery
RESEND_API_KEY=

# Allowed origins for the auth service CORS
AUTH_ALLOWED_ORIGINS=https://agents.dcp.sa,https://project-agent-dc11.vercel.app

# Public URL where the auth API is reachable (set after DNS + nginx vhost are up)
AUTH_PUBLIC_URL=https://auth.agents.dcp.sa
